# Copy to .env (gitignored) and fill in. Never paste keys into notebooks or code.
# Anthropic: use a key from a dedicated Console workspace ("oseas26") that has a spend limit.
ANTHROPIC_API_KEY=

# Google Earth Engine service-account JSON: put the PATH here, keep the file in ~/.config/rooftops/ (chmod 600)
GEE_SERVICE_ACCOUNT_JSON=
GEE_PROJECT=

# Later, for publishing
HF_TOKEN=
ZENODO_TOKEN=

# Tool-native credentials live in their own files, not here:
#   Copernicus CDS  -> ~/.cdsapirc
#   NASA Earthdata  -> ~/.netrc
