# Rooftops → Load Curves dashboard on a home machine, published with Tailscale Funnel.
# Caddy listens on localhost:2004 only (2004: Jean de Dieu Nkundabera's Paralympic bronze, Rwanda's first
# Paralympic medal); `tailscale funnel` gives it a public HTTPS address. See docs/hosting.md.
{
	admin localhost:2019
}

http://:2004 {
	bind 127.0.0.1 ::1
	encode zstd gzip

	# data: no directory listings, no opening files directly in the address bar
	handle /data/* {
		root * /srv/peek-load
		@typed header Sec-Fetch-Dest document
		respond @typed 403
		header Cache-Control "public, max-age=604800"
		file_server
	}

	# the site
	handle {
		root * /srv/peek-load/site
		@page path / /index.html
		header @page Cache-Control "no-cache"
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
